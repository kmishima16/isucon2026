# 問題ごとに変えるのはこのファイルだけ。（bash の書式。scripts/ から読み込まれる）
# 道具の既定値（計測の秒数・ポート・pprotein の版など）は scripts/lib.sh にある。変えたいときだけここに書く

# isuenv の環境名（make up / down / doctor で使う）。本番では空にする
ENV="private-isu"

# 競技サーバー（~/.ssh/config の Host 名。複数台はスペース区切り）
HOSTS="private-isu-1"
APP_HOSTS="$HOSTS"                 # アプリを配る先
NGINX_HOST="${HOSTS%% *}"          # access log を解析するホスト
DB_HOST="${HOSTS%% *}"             # slow log の解析と sql/ の適用先
BENCH_HOST="private-isu-bench"     # doctor で疎通を見るだけ（無ければ空）

# アプリ
APP_LOCAL="webapp/golang"                         # リポジトリ内
APP_REMOTE="/home/isucon/private_isu/webapp/golang"  # サーバー上
APP_USER="isucon"
APP_EXCLUDE="app"                                 # 転送しないもの（ビルド成果物など。スペース区切り）
BUILD_CMD="go build -o app ."                     # APP_REMOTE で APP_USER のログインシェルとして実行
SERVICE="isu-go"
HEALTH_URL="http://localhost/"                    # 各アプリホスト上で叩く

# 初回 make setup で各ホストに root で実行する追加コマンド（冪等に書く）
SETUP_CMD="systemctl disable --now isu-ruby 2>/dev/null || true; systemctl enable --now isu-go"

# DB（sql/*.sql の適用に使う）
MYSQL_CMD="mysql -uisuconp -pisuconp isuconp"

# 計測
NGINX_LOG="/var/log/nginx/access.ltsv"
SLOW_LOG="/var/log/mysql/mysql-slow.log"
ALP_MATCH='^/posts/[0-9]+$,^/@[^/]+$,^/image/[0-9]+\.(jpg|png|gif)$'
PPROF_HOST="${HOSTS%% *}"
PPROF_URL="http://localhost:6060/debug/pprof/profile?seconds=50"   # アプリに pprof を入れたら有効
FGPROF_URL=""                                                      # fgprof も入れたら "http://localhost:6060/debug/fgprof?seconds=50"（空なら取らない）

# 回帰チェック（make snapshot → 施策 → make compare）。応答を取るページと、比べる前に消す毎回変わる部分（sed -E の正規表現）
SNAPSHOT_URLS="/ /posts/1 /posts/10000 /@mary /@patricia /posts?max_created_at=2016-01-02T10:30:00%2B09:00 /image/1.jpg /login /register /css/style.css"
SNAPSHOT_IGNORE='name="csrf_token" value="[0-9a-f]*"'

# 手元の docker compose（make local-seed / local-up / local-down）と Playwright の巡回（make patrol）
LOCAL_DB_NAME="isuconp"
LOCAL_SEED="users posts:id<=100 comments:post_id<=100"        # 手元の DB に入れる部分ダンプ（テーブル[:WHERE] をスペース区切り）
LOCAL_PUBLIC_REMOTE="/home/isucon/private_isu/webapp/public"   # 静的ファイルの元（image/ は除いて local/public に取る）
LOCAL_NGINX_SITE="server/all/etc/nginx/sites-available/isucon.conf"  # 手元の nginx に使うサイト設定

# pprotein（計測を画面とファイルで見る。make pp-up で Mac に起動）。使わないなら PPROTEIN_AGENT_PORT="" と書く
PPROTEIN_PPROF_PORT="6060"                   # アプリの pprof の待ち受け（アプリに入れていなければ空）
PPROTEIN_PPROF_PATHS="/debug/pprof/profile"  # fgprof も入れたら "/debug/pprof/profile /debug/fgprof"

# ベンチ。手元から実行できる練習環境だけ。本番（ポータルから実行）では空にする
BENCH_CMD='eval "$(isuenv bench private-isu)"'

# ポータルのベンチ結果を取り出す（make portal）。本番当日にポータルを開発者ツールで見て URL と JSON の場所を埋める。
# 認証の Cookie は .envrc の PORTAL_COOKIE に書く。URL が空なら PORTAL_RESULT_CMD の出力（JSON）を使う
PORTAL_RESULT_URL=""
# 練習用：ポータルの代わりに、直近の make bench が出した結果の JSON を使う
PORTAL_RESULT_CMD='grep -ho "{\"pass\".*}" "$(ls -t logs/*-bench.txt | head -1)" | tail -1'
# JSON の形が既定（.pass / .score / .messages、ID なし）と違えば PORTAL_JQ_PICK・ID・PASS・SCORE・MESSAGES を書く（既定値は scripts/lib.sh）

# ssh の追加オプション（練習環境はインスタンスごとにホスト鍵が変わる）
SSH_EXTRA_OPTS="-o StrictHostKeyChecking=accept-new"
