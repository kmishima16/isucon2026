# 問題ごとに変えるのはこのファイルだけ。（bash の書式。scripts/ から読み込まれる）
# 道具の既定値（計測の秒数・ポート・pprotein の版など）は scripts/lib.sh にある。変えたいときだけここに書く

# isuenv の環境名（make up / down / doctor で使う）。本番では空にする
ENV=""

# 競技サーバー（~/.ssh/config の Host 名。複数台はスペース区切り）
HOSTS="asia1 europe1 america1 asia2"
APP_HOSTS="asia1 europe1 america1"   # アプリを配る先（asia2 は DB だけ）
NGINX_HOST="asia1"                    # access log を解析するホスト（アプリ 3 台に分かれている。ほかの台は手で alp を回す）
DB_HOST="asia2"                       # sql/ の適用先（PostgreSQL 16）
BENCH_HOST=""                         # ベンチはポータルから

# アプリ
APP_LOCAL="webapp"                                # リポジトリ内
APP_REMOTE="/home/isucon/webapp"                  # サーバー上。初期化が go/ から ../sql/init.sh を呼ぶので sql/ ごと持つ
APP_USER="isucon"
APP_EXCLUDE="go/isureal nodejs perl php python ruby rust ._*"  # 転送しないもの（ビルド成果物・使わない言語・macOS の ._ ファイル。外したものは deploy の --delete でも消えない。スペース区切り）
BUILD_CMD="cd go && /home/isucon/local/go/bin/go build -o isureal ./cmd/isureal"  # APP_REMOTE で APP_USER のログインシェルとして実行。go は PATH に無いので絶対パス
SERVICE="isureal-go"
HEALTH_URL="http://localhost/"                    # 各アプリホスト上で叩く。認証なしで 2xx を返す API が無いので nginx の index.html で見る（アプリの生死は deploy の後に :8080/api/me が 401 かで確かめる）

# 初回 make setup で各ホストに root で実行する追加コマンド（冪等に書く）
# 台を作り直すと AMI の状態に戻るので、毎回入れ直すもの（env.sh の書き換え、DNS のゾーンの入れ直しなど）もここに書く。
# 台の役割は、台の IP で分けられる。台の上で展開したい $ は \$ と書く。例（DB だけの台ではアプリを止め、ほかの台はアプリの接続先を DB の台に向ける）：
#   ME=\$(hostname -I | cut -d' ' -f1); if [ \"\$ME\" = \"$DB_ADDR\" ]; then systemctl disable --now isu-go; else sed -i \"s/^DB_HOST=.*/DB_HOST=$DB_ADDR/\" /home/isucon/env.sh; fi
SETUP_CMD=""

# DB（sql/*.sql の適用に使う）
# PostgreSQL なので psql。deploy が末尾に足す --force を bash -c の $1 として捨てる。NOTICE（IF NOT EXISTS の skipping）はエラー扱いされないよう出さない
# make measure-show と make reboot-test の行数は MySQL 前提で動かない（手で数える）
MYSQL_CMD="sudo -u postgres bash -c 'PGOPTIONS=-cclient_min_messages=warning psql -X -q -v ON_ERROR_STOP=1 -d isureal' _"

# 計測
NGINX_LOG="/var/log/nginx/access.ltsv"
SLOW_LOG=""                                       # PostgreSQL は pt-query-digest で読めないので使わない（pg_stat_statements を手で見る）
ALP_MATCH='^/api/users/[0-9a-f-]{36}$,^/api/posts/[0-9a-f-]{36}$,^/api/posts/[0-9a-f-]{36}/comments$,^/api/posts/[0-9a-f-]{36}/realmojis$,^/api/comments/[0-9a-f-]{36}$,^/api/realmojis/[0-9a-f-]{36}$,^/api/images/[0-9a-f-]{36}$,^/api/memories/[0-9]{4}-[0-9]{2}-[0-9]{2}$,^/api/friend-requests/[0-9a-f-]{36}/[a-z]+$,^/api/friendships/[0-9a-f-]{36}$,^/api/follows/[0-9a-f-]{36}$,^/api/blocks/[0-9a-f-]{36}$,^/api/admin/users/[0-9a-f-]{36}/certification$'   # ID は UUID。フィードと関係一覧は種類ごとに分けて見る
PPROF_HOST="asia1"
PPROF_URL="http://localhost:6060/debug/pprof/profile?seconds=50"   # アプリに pprof を入れたら有効
FGPROF_URL=""                                                      # fgprof も入れたら "http://localhost:6060/debug/fgprof?seconds=50"（空なら取らない）

# 回帰チェック（make snapshot → 施策 → make compare）。応答を取るページと、比べる前に消す毎回変わる部分（sed -E の正規表現）
SNAPSHOT_URLS=""                                  # API はすべてログインが要り、セッションは初期化で消えるので snapshot は使わない
SNAPSHOT_IGNORE=""
SNAPSHOT_INIT="/api/initialize"
SNAPSHOT_INIT_METHOD="POST"

# 手元の docker compose（make local-seed / local-up / local-down）と Playwright の巡回（make patrol）
LOCAL_DB_NAME="isureal"
LOCAL_SEED=""                                      # make local-seed は mysqldump 前提で使えない。pg_dump を手で取る（local/data/）
LOCAL_PUBLIC_REMOTE="/home/isucon/webapp/public"
LOCAL_NGINX_SITE="server/all/etc/nginx/sites-available/isureal.conf"
LOCAL_UPSTREAM="127.0.0.1:8080"                    # サイト設定の中のアプリの宛先

# pprotein（計測を画面とファイルで見る。make pp-up で Mac に起動）。使わないなら PPROTEIN_AGENT_PORT="" と書く
PPROTEIN_PPROF_PORT="6060"                   # アプリの pprof の待ち受け（アプリに入れていなければ空）
PPROTEIN_PPROF_PATHS="/debug/pprof/profile"  # fgprof も入れたら "/debug/pprof/profile /debug/fgprof"

# ベンチ。手元から実行できる練習環境だけ。本番（ポータルから実行）では空にする
BENCH_CMD=""

# ポータルのベンチ結果を取り出す（make portal）。本番当日にポータルを開発者ツールで見て URL と JSON の場所を埋める。
# 認証の Cookie は .envrc の PORTAL_COOKIE に書く。URL が空なら PORTAL_RESULT_CMD の出力（JSON）を使う
PORTAL_RESULT_URL=""
# 練習用：ポータルの代わりに、直近の make bench が出した結果の JSON を使う
PORTAL_RESULT_CMD='grep -ho "{\"pass\".*}" "$(ls -t logs/*-bench.txt | head -1)" | tail -1'
# JSON の形が既定（.pass / .score / .fail / .messages、ID なし）と違えば PORTAL_JQ_PICK・ID・PASS・SCORE・FAIL・MESSAGES を書く（既定値は scripts/lib.sh）

# ssh の追加オプション（練習環境はインスタンスごとにホスト鍵が変わる）
SSH_EXTRA_OPTS=""
