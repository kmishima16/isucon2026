{
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(git *)",
      "Bash(ssh *)",
      "Bash(rsync *)",
      "Bash(isuenv list)",
      "Bash(isuenv bench *)",
      "Bash(isuenv problems)",
      "Bash(direnv exec . make *)"
    ],
    "deny": [
      "Bash(make up)",
      "Bash(make up *)",
      "Bash(make down)",
      "Bash(make down *)",
      "Bash(direnv exec . make up)",
      "Bash(direnv exec . make up *)",
      "Bash(direnv exec . make down)",
      "Bash(direnv exec . make down *)",
      "Bash(isuenv up *)",
      "Bash(isuenv down *)",
      "Bash(isuenv nuke*)",
      "Bash(aws *)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/after-bash.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/before-stop.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
